# Normalize line endings for text; never touch binaries.
* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf
*.joblib binary
*.xlsx   binary
*.png    binary
*.ico    binary
*.npz    binary
# Large model weights are stored with Git LFS (run `git lfs install` once, then `git lfs pull` after cloning).
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.h5          filter=lfs diff=lfs merge=lfs -text
